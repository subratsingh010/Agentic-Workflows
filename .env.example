APP_ENV=local
APP_NAME=employee-support-agent
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/employee_support
SYNC_DATABASE_URL=postgresql://app:app@postgres:5432/employee_support
REDIS_URL=redis://redis:6379/0
PERSISTENCE_BACKEND=postgres
CACHE_BACKEND=redis
RAG_BACKEND=milvus
RABBITMQ_URL=amqp://app:app@rabbitmq:5672//
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=employee_policy_chunks
MILVUS_NATIVE_HYBRID=true
MILVUS_VECTOR_DIM=384
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
KEYCLOAK_ISSUER=http://keycloak:8080/realms/employee-support
KEYCLOAK_AUDIENCE=employee-support-api
JWKS_CACHE_SECONDS=300
LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
RAG_TOP_K=5
RAG_DENSE_WEIGHT=0.6
RAG_SPARSE_WEIGHT=0.4
RAG_RERANK_ENABLED=true
RAG_RETRIEVAL_MODE=hybrid
RAG_FUSION_STRATEGY=weighted
RAG_CANDIDATE_MULTIPLIER=4
RAG_RRF_K=60
RAG_BM25_K1=1.5
RAG_BM25_B=0.75
RAG_RERANKER_PROVIDER=score
RAG_CHUNK_SIZE=120
RAG_CHUNK_OVERLAP=20
POLICY_SOURCE_DIR=data/policies/source
RATE_LIMIT_PER_MINUTE=60
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006
LOG_LEVEL=INFO

DB_HOST=localhost
POSTGRES_DB=support_ai_agent
